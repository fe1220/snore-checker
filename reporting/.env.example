# make meta-report 설정. 이 파일을 .env.local로 복사해 값을 채운다(.env.local은 git 제외).
# 메타 시스템 사용자 토큰 (ads_read)
META_ACCESS_TOKEN=
# 이번 캠페인 ID
META_CAMPAIGN_ID=
# GA4 속성 ID (숫자)
GA4_PROPERTY_ID=
# GA4 속성에 뷰어 권한을 준 서비스 계정 키(JSON) 파일 경로. 저장소 밖에 둔다
GA4_CREDENTIALS_FILE=
# 광고 URL의 utm_source 값 (기본 meta)
UTM_SOURCE=meta
# GA4 국가 필터. 광고는 한국에만 나가고, 메타 광고 심사 봇이 미국·스웨덴·아일랜드에서 들어온다 (기본 South Korea)
# GA4_COUNTRY=South Korea
# 메타 API 버전 (기본 v26.0)
# META_API_VERSION=v26.0
